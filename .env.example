# frankenphp-magento2 — every setting lives here.
# Copy it and go:  cp .env.example .env
# Defaults are the recommended values from the Mage-OS system requirements
# (https://mage-os.org/get-started/system-requirements), checked 2026-11-12.

COMPOSE_PROJECT_NAME=frankenphp-magento2

# ---------------------------------------------------------------------------
# Runtime: which web server runs PHP
#   FrankenPHP:     COMPOSE_FILE=compose.yml:compose.frankenphp.yml
#   nginx/php-fpm:  COMPOSE_FILE=compose.yml:compose.nginx-fpm.yml
# FRANKENPHP_MODE: classic (a fresh PHP run per request, like php-fpm)
#                  worker  (Magento boots once and stays in memory, experimental)
# ---------------------------------------------------------------------------
COMPOSE_FILE=compose.yml:compose.frankenphp.yml
FRANKENPHP_MODE=classic

# ---------------------------------------------------------------------------
# Optional extras, comma separated, all off by default:
#   rabbitmq, mailpit, opensearch-dashboards, varnish
# ---------------------------------------------------------------------------
COMPOSE_PROFILES=
# With varnish, Varnish answers on HTTP_PORT and the runtime needs another port: uncomment WEB_PORT.
#WEB_PORT=8081

# ---------------------------------------------------------------------------
# Magento
#   mageos:  Mage-OS, no keys needed
#   magento: Magento Open Source, needs keys from
#            https://commercemarketplace.adobe.com/customer/accessKeys/
#            (for MAGENTO_VERSION use e.g. 2.4.9)
# ---------------------------------------------------------------------------
MAGENTO_DISTRIBUTION=mageos
MAGENTO_VERSION=4.0.0
MAGENTO_COMPOSER_PUBLIC_KEY=
MAGENTO_COMPOSER_PRIVATE_KEY=
SAMPLE_DATA=1
ADMIN_USER=admin
ADMIN_PASSWORD=Admin123!
ADMIN_EMAIL=admin@example.com

# ---------------------------------------------------------------------------
# Versions
# ---------------------------------------------------------------------------
# Full patch version: FrankenPHP and php-fpm must run the very same PHP.
PHP_VERSION=8.5.12
FRANKENPHP_VERSION=1.13.5
NGINX_VERSION=1.28
COMPOSER_VERSION=2.10.2

# mariadb or mysql. Recommended: mariadb 12.3, mysql 8.4.
# Each engine keeps its own data: switching needs a reinstall.
DB_ENGINE=mariadb
DB_VERSION=12.3

OPENSEARCH_VERSION=3.9.0
VALKEY_VERSION=8.0
RABBITMQ_VERSION=4.1
VARNISH_VERSION=7.7
MAILPIT_VERSION=v1.33.1

# ---------------------------------------------------------------------------
# Resources — the same for every runtime, so the comparison is fair
#   PHP_WORKERS: php-fpm children, FrankenPHP threads and workers
# ---------------------------------------------------------------------------
PHP_WORKERS=8
APP_CPUS=4
APP_MEMORY=4g
OPENSEARCH_HEAP=1g

# ---------------------------------------------------------------------------
# Ports on your machine
# ---------------------------------------------------------------------------
HTTP_PORT=8080
DB_PORT=3306
RABBITMQ_UI_PORT=15672
MAILPIT_UI_PORT=8025
OPENSEARCH_DASHBOARDS_PORT=5601

# ---------------------------------------------------------------------------
# Database credentials (local only)
# ---------------------------------------------------------------------------
DB_NAME=magento
DB_USER=magento
DB_PASSWORD=magento
DB_ROOT_PASSWORD=root
